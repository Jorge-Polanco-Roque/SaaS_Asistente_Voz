# Voice Service Configuration
BACKEND_URL=http://backend:3001

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here

# Webhook URL (your public endpoint for ElevenLabs to call)
# Use ngrok, Cloud Run, or your production URL
WEBHOOK_BASE_URL=https://your-domain.com

# Redis Configuration (for session state)
REDIS_URL=redis://redis:6379/0

# OpenAI (for LangGraph)
OPENAI_API_KEY=your_openai_api_key_here

# Google Service Account (shared with Calendar)
# JSON string of the service account credentials
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Sheets (Table Reservations)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_MESAS_SHEET=Mesas
GOOGLE_SHEETS_RESERVAS_SHEET=Reservas
